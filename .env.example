# Copie este arquivo para ".env" e ajuste se necessário.
# A A.R.I.A. agora usa só o Ollama (IA local) — sem cota, sem API paga.

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=3

# Dica de velocidade: se as respostas estiverem lentas no seu PC, troque
# OLLAMA_MODEL por um modelo menor, como llama3.2:1b ou phi3:mini
# (baixe com "ollama pull <modelo>" antes de usar).

# Voz (Speech-to-Text / Text-to-Speech) — tudo local, sem API externa.
WHISPER_MODEL=base
WHISPER_IDIOMA=pt
TTS_VELOCIDADE=170

# Voz — Speech-to-Text (Whisper local) e Text-to-Speech (motor do SO).
# Tudo local, sem API externa e sem cota.
WHISPER_MODEL=base
WHISPER_IDIOMA=pt
TTS_VELOCIDADE=170
